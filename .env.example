# ── CodeSentinel configuration (copy to .env) ──────────────────────────────
# Anthropic API key for real-LLM mode. Leave unset to run in deterministic
# offline mode (heuristic detectors + mock LLM). Required for full AI review.
ANTHROPIC_API_KEY=

# Force deterministic offline mode even if an API key is present (CI, air-gapped).
# CODESENTINEL_MOCK_LLM=1

# Model selection (defaults to a current Claude Sonnet).
# CODESENTINEL_MODEL=claude-sonnet-4-5

# ── API service ────────────────────────────────────────────────────────────
# Comma-separated API keys accepted by the REST service (format: tenant:secret).
# CODESENTINEL_API_KEYS=acme:replace-with-strong-secret,gov-dept:another-secret
# Bind address / port for `codesentinel serve`.
CODESENTINEL_HOST=0.0.0.0
CODESENTINEL_PORT=8080
# Max request body size (bytes) accepted by the API.
CODESENTINEL_MAX_BODY_BYTES=1048576

# ── Licensing (Enterprise/Government editions) ─────────────────────────────
# Signed license key unlocks enterprise features (SSO, audit export, multi-tenant).
# CODESENTINEL_LICENSE_KEY=

# ── Audit & observability ──────────────────────────────────────────────────
# Path for the append-only, hash-chained audit log (compliance).
CODESENTINEL_AUDIT_LOG=./codesentinel-audit.log
# Log format: json (production) or text (local dev).
CODESENTINEL_LOG_FORMAT=json
